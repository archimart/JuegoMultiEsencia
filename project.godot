; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="JuegoMultiPixelArt"
run/main_scene="res://scenes/race_select.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

FX="*res://autoload/fx.gd"
SFX="*res://autoload/sfx.gd"
GameState="*res://autoload/game_state.gd"
CompanionSystem="*res://autoload/companion_system.gd"
FamiliarSystem="*res://autoload/familiar_system.gd"
UIManager="*res://autoload/ui_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[layer_names]

2d_physics/layer_1="Mundo"
2d_physics/layer_2="Jugadores"
2d_physics/layer_3="Compañeros"
2d_physics/layer_4="Monstruos"
2d_physics/layer_5="Proyectiles"
2d_physics/layer_6="Recogibles"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
